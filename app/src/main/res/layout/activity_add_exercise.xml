<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_aura_screen">
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingBottom="24dp">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="6dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">
            <TextView
                android:layout_width="42dp"
                android:layout_height="48dp"
                android:text="‹"
                android:textColor="#267D4C"
                android:textSize="30sp"
                android:id="@+id/exerciseAddBack"
                android:gravity="center"
                android:contentDescription="Quay lại" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thêm vận động"
                android:textColor="#1F3D2E"
                android:textSize="23sp"
                android:textStyle="bold" />
          </LinearLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Ghi lại hoạt động thể chất của bạn. Ứng dụng sẽ tính năng lượng tiêu hao."
              android:textColor="@color/text_secondary"
              android:textSize="13sp"
              android:layout_marginTop="6dp"
              android:maxLines="3"
              android:lineSpacingExtra="2dp" />
        </LinearLayout>
        <ImageView
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:src="@drawable/ap_dumbbell"
            android:scaleType="fitCenter"
            android:contentDescription="Minh họa AuraPlate"
            android:layout_marginStart="6dp" />
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="18dp" />
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Chọn loại hoạt động"
          android:textColor="#1F3D2E"
          android:textSize="16sp"
          android:textStyle="bold" />
      <Space
          android:layout_width="match_parent"
          android:layout_height="10dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/exerciseCardWalk"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_fgm_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true">
          <ImageView
              android:layout_width="34dp"
              android:layout_height="34dp"
              android:src="@drawable/ap_walking"
              android:contentDescription="Đi bộ"
              android:scaleType="fitCenter" />
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:text="Đi bộ"
              android:textSize="12sp"
              android:textStyle="bold"
              android:gravity="center"
              android:textColor="@color/text_primary"
              android:maxLines="2" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/exerciseCardRun"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_fgm_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true">
          <ImageView
              android:layout_width="34dp"
              android:layout_height="34dp"
              android:src="@drawable/ap_running"
              android:contentDescription="Chạy bộ"
              android:scaleType="fitCenter" />
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:text="Chạy bộ"
              android:textSize="12sp"
              android:textStyle="bold"
              android:gravity="center"
              android:textColor="@color/text_primary"
              android:maxLines="2" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/exerciseCardYoga"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_fgm_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true">
          <ImageView
              android:layout_width="34dp"
              android:layout_height="34dp"
              android:src="@drawable/ap_yoga"
              android:contentDescription="Yoga"
              android:scaleType="fitCenter" />
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:text="Yoga"
              android:textSize="12sp"
              android:textStyle="bold"
              android:gravity="center"
              android:textColor="@color/text_primary"
              android:maxLines="2" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/exerciseCardGym"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_fgm_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true">
          <ImageView
              android:layout_width="34dp"
              android:layout_height="34dp"
              android:src="@drawable/ap_gym"
              android:contentDescription="Tập gym"
              android:scaleType="fitCenter" />
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:text="Tập gym"
              android:textSize="12sp"
              android:textStyle="bold"
              android:gravity="center"
              android:textColor="@color/text_primary"
              android:maxLines="2" />
        </LinearLayout>
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="6dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical">
        <LinearLayout
            android:id="@+id/exerciseCardBike"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_fgm_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true">
          <ImageView
              android:layout_width="34dp"
              android:layout_height="34dp"
              android:src="@drawable/ap_cycle"
              android:contentDescription="Đạp xe"
              android:scaleType="fitCenter" />
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:text="Đạp xe"
              android:textSize="12sp"
              android:textStyle="bold"
              android:gravity="center"
              android:textColor="@color/text_primary"
              android:maxLines="2" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/exerciseCardDance"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_fgm_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true">
          <ImageView
              android:layout_width="34dp"
              android:layout_height="34dp"
              android:src="@drawable/ap_dance"
              android:contentDescription="Nhảy múa"
              android:scaleType="fitCenter" />
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:text="Nhảy múa"
              android:textSize="12sp"
              android:textStyle="bold"
              android:gravity="center"
              android:textColor="@color/text_primary"
              android:maxLines="2" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/exerciseCardSwim"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_fgm_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true">
          <ImageView
              android:layout_width="34dp"
              android:layout_height="34dp"
              android:src="@drawable/ap_swim"
              android:contentDescription="Bơi lội"
              android:scaleType="fitCenter" />
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:text="Bơi lội"
              android:textSize="12sp"
              android:textStyle="bold"
              android:gravity="center"
              android:textColor="@color/text_primary"
              android:maxLines="2" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/exerciseCardOther"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_fgm_card"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="5dp"
            android:clickable="true"
            android:focusable="true">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="31dp"
              android:text="•••"
              android:textSize="19sp"
              android:textColor="@color/text_primary"
              android:gravity="center" />
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginTop="3dp"
              android:text="Khác"
              android:textSize="12sp"
              android:textStyle="bold"
              android:gravity="center"
              android:textColor="@color/text_primary"
              android:id="@+id/exerciseCardOtherLabel"
              android:maxLines="2" />
        </LinearLayout>
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="21dp" />
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Thông tin chi tiết"
          android:textColor="#1F3D2E"
          android:textSize="16sp"
          android:textStyle="bold" />
      <Space
          android:layout_width="match_parent"
          android:layout_height="10dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="12dp"
          android:background="@drawable/bg_fgm_card">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱  Thời gian vận động"
            android:textColor="#496854"
            android:textSize="13sp"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/exerciseDurationSpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="10dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="12dp"
          android:background="@drawable/bg_fgm_card">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥  Cường độ"
            android:textColor="#496854"
            android:textSize="13sp"
            android:textStyle="bold" />
        <Spinner
            android:id="@+id/exerciseIntensitySpinner"
            android:layout_width="match_parent"
            android:layout_height="48dp" />
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="10dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="14dp"
          android:background="@drawable/bg_fgm_card">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚖  Cân nặng hiện tại (tự động từ hồ sơ)"
            android:textColor="#496854"
            android:textSize="13sp"
            android:textStyle="bold" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-- kg"
            android:textColor="#267D4C"
            android:textSize="17sp"
            android:textStyle="bold"
            android:id="@+id/exerciseWeightValue" />
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="18dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp"
          android:background="@drawable/bg_fgm_soft">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Năng lượng tiêu hao (ước tính)"
            android:textColor="#267D4C"
            android:textSize="15sp"
            android:textStyle="bold" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="7dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--- kcal"
            android:textColor="#267D4C"
            android:textSize="24sp"
            android:textStyle="bold"
            android:id="@+id/exerciseCaloriesEstimate" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
  <TextView
      android:layout_width="match_parent"
      android:layout_height="54dp"
      android:text="Lưu hoạt động"
      android:textColor="#FFFFFF"
      android:textSize="17sp"
      android:textStyle="bold"
      android:id="@+id/exerciseSave"
      android:gravity="center"
      android:background="@drawable/bg_fgm_button"
      android:layout_margin="16dp" />
</LinearLayout>
