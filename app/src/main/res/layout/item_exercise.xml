<?xml version='1.0' encoding='UTF-8'?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/card_bg"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="14dp">
    <TextView
        android:id="@+id/tvExerciseIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_pill_badge_orange"
        android:gravity="center"
        android:text="🏃"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tvExerciseName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="Chạy bộ ngoài trời"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/tvExerciseCalories"
        app:layout_constraintStart_toEndOf="@+id/tvExerciseIcon"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/tvExerciseDuration"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:text="30 phút • Cardio"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@+id/tvExerciseCalories"
        app:layout_constraintStart_toEndOf="@+id/tvExerciseIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvExerciseName" />
    <TextView
        android:id="@+id/tvExerciseTime"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        android:text="06:30"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@+id/tvExerciseCalories"
        app:layout_constraintStart_toEndOf="@+id/tvExerciseIcon"
        app:layout_constraintTop_toBottomOf="@+id/tvExerciseDuration" />
    <TextView
        android:id="@+id/tvExerciseCalories"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_pill_badge_orange"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:text="-240 kcal"
        android:textColor="@color/accent_orange"
        android:textSize="13sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
