<?xml version='1.0' encoding='UTF-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aura_screen"
    android:fillViewport="true">
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingHorizontal="20dp"
      android:paddingTop="18dp"
      android:paddingBottom="24dp">
    <!-- Nút Back -->
    <ImageButton
        android:id="@+id/btnBackEditProfile"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_circle_button"
        android:backgroundTint="#E6F4EC"
        android:contentDescription="Quay lại"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary_green" />
    <!-- Badge "Khởi đầu khỏe mạnh" -->
    <TextView
        android:id="@+id/tvBadgeStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_field_outlined"
        android:paddingHorizontal="14dp"
        android:paddingVertical="7dp"
        android:text="Khởi đầu khỏe mạnh"
        android:textColor="#C48828"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@+id/btnBackEditProfile"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/btnBackEditProfile" />
    <!-- Tiêu đề chính -->
    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Chỉnh sửa hồ sơ"
        android:textColor="@color/text_primary"
        android:textSize="25sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBackEditProfile" />
    <!-- Phụ đề -->
    <TextView
        android:id="@+id/tvHeaderSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Cập nhật thông tin cá nhân của bạn"
        android:textColor="#5B7E6B"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvHeaderTitle" />
    <!-- Card Thông tin cơ bản -->
    <LinearLayout
        android:id="@+id/cardBasicInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_card_basic_info"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintTop_toBottomOf="@+id/tvHeaderSubtitle">
      <!-- Tiêu đề card -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center_vertical"
          android:orientation="horizontal">
        <ImageView
            android:id="@+id/ivBasicInfoIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="Thông tin cơ bản"
            android:src="@drawable/ic_person_circle_badge" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="Thông tin cơ bản"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
      </LinearLayout>
      <!-- Hàng 1: Tuổi & Giới tính -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:baselineAligned="false"
          android:orientation="horizontal">
        <!-- Tuổi -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:orientation="vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Tuổi"
              android:textColor="#2A3E33"
              android:textSize="13sp"
              android:textStyle="bold" />
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="52dp"
              android:layout_marginTop="8dp"
              android:background="@drawable/bg_field_outlined"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:paddingHorizontal="14dp">
            <EditText
                android:id="@+id/edtEditAge"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="--"
                android:inputType="number"
                android:maxLength="3"
                android:textColor="#2A3E33"
                android:textColorHint="#4A5D52"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="tuổi"
                android:textColor="#9AA5A0"
                android:textSize="14sp" />
          </LinearLayout>
        </LinearLayout>
        <!-- Giới tính -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Giới tính"
              android:textColor="#2A3E33"
              android:textSize="13sp"
              android:textStyle="bold" />
          <LinearLayout
              android:id="@+id/layoutSelectGender"
              android:layout_width="match_parent"
              android:layout_height="52dp"
              android:layout_marginTop="8dp"
              android:background="@drawable/bg_field_outlined"
              android:clickable="true"
              android:focusable="true"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:paddingHorizontal="14dp">
            <TextView
                android:id="@+id/tvEditGender"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="--"
                android:textColor="#2A3E33"
                android:textSize="15sp"
                android:textStyle="bold" />
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Chọn giới tính"
                android:src="@android:drawable/arrow_down_float"
                app:tint="#7A8A82" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
      <!-- Hàng 2: Chiều cao & Cân nặng hiện tại -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="14dp"
          android:baselineAligned="false"
          android:orientation="horizontal">
        <!-- Chiều cao -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:orientation="vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Chiều cao"
              android:textColor="#2A3E33"
              android:textSize="13sp"
              android:textStyle="bold" />
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="52dp"
              android:layout_marginTop="8dp"
              android:background="@drawable/bg_field_outlined"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:paddingHorizontal="14dp">
            <EditText
                android:id="@+id/edtEditHeight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="--"
                android:inputType="numberDecimal"
                android:maxLength="6"
                android:textColor="#2A3E33"
                android:textColorHint="#4A5D52"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="cm"
                android:textColor="#9AA5A0"
                android:textSize="14sp" />
          </LinearLayout>
        </LinearLayout>
        <!-- Cân nặng hiện tại -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:orientation="vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Cân nặng hiện tại"
              android:textColor="#2A3E33"
              android:textSize="13sp"
              android:textStyle="bold" />
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="52dp"
              android:layout_marginTop="8dp"
              android:background="@drawable/bg_field_outlined"
              android:gravity="center_vertical"
              android:orientation="horizontal"
              android:paddingHorizontal="14dp">
            <EditText
                android:id="@+id/edtEditWeight"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:hint="--"
                android:inputType="numberDecimal"
                android:maxLength="6"
                android:textColor="#2A3E33"
                android:textColorHint="#4A5D52"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="kg"
                android:textColor="#9AA5A0"
                android:textSize="14sp" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
      <!-- Mức độ vận động -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:text="Mức độ vận động"
          android:textColor="#2A3E33"
          android:textSize="13sp"
          android:textStyle="bold" />
      <LinearLayout
          android:id="@+id/layoutActivityLevel"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="8dp"
          android:background="@drawable/bg_field_outlined"
          android:clickable="true"
          android:focusable="true"
          android:gravity="center_vertical"
          android:minHeight="62dp"
          android:orientation="horizontal"
          android:paddingHorizontal="14dp"
          android:paddingVertical="10dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
          <TextView
              android:id="@+id/tvActivityLevelTitle"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Vận động nhẹ"
              android:textColor="#26382E"
              android:textSize="14sp"
              android:textStyle="bold" />
          <TextView
              android:id="@+id/tvActivityLevelDesc"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:text="Đi bộ, thể dục 1-3 buổi/tuần"
              android:textColor="#7A8A82"
              android:textSize="12sp" />
        </LinearLayout>
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="Chọn mức độ vận động"
            android:src="@android:drawable/arrow_down_float"
            app:tint="#7A8A82" />
      </LinearLayout>
      <!-- Banner lưu trên thiết bị -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="16dp"
          android:background="@drawable/bg_banner_saved_device"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:padding="12dp">
        <ImageView
            android:id="@+id/ivSavedOnDevice"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_tick_circle"
            android:contentDescription="Đã lưu trên thiết bị"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_check_mark"
            app:tint="@color/primary_green" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Thông tin sẽ được lưu trên thiết bị"
              android:textColor="#4A8663"
              android:textSize="13sp"
              android:textStyle="bold" />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="2dp"
              android:text="Bạn có thể cập nhật lại trong mục Cá nhân"
              android:textColor="#689C7D"
              android:textSize="12sp" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>
    <!-- Nút Lưu thay đổi -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveProfile"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:text="Lưu thay đổi"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_green"
        app:cornerRadius="16dp"
        app:layout_constraintTop_toBottomOf="@+id/cardBasicInfo" />
    <!-- Ghi chú dưới nút -->
    <TextView
        android:id="@+id/tvFooterNote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Bạn có thể cập nhật hồ sơ bất cứ lúc nào"
        android:textColor="#96A09B"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSaveProfile" />
  </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
