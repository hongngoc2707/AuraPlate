<?xml version='1.0' encoding='UTF-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aura_screen"
    android:fillViewport="true"
    android:overScrollMode="never">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:gravity="center_horizontal"
      android:paddingStart="24dp"
      android:paddingEnd="24dp"
      android:paddingTop="46dp"
      android:paddingBottom="34dp">
    <ImageView
        android:layout_width="156dp"
        android:layout_height="140dp"
        android:src="@drawable/ap_app_logo"
        android:scaleType="fitCenter"
        android:contentDescription="Logo AuraPlate" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Cân bằng dinh dưỡng\ncho cuộc sống khỏe mạnh"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:textSize="24sp"
        android:textColor="@color/primary_green" />
    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <ImageView
        android:layout_width="278dp"
        android:layout_height="266dp"
        android:layout_marginTop="12dp"
        android:src="@drawable/ap_salad"
        android:scaleType="fitCenter"
        android:contentDescription="Đĩa ăn lành mạnh" />
    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ăn uống lành mạnh, sống tích cực"
        android:gravity="center"
        android:textColor="@color/primary_green_dark"
        android:textStyle="bold"
        android:textSize="18sp" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Theo dõi dinh dưỡng mỗi ngày"
        android:textStyle="italic"
        android:gravity="center"
        android:textColor="@color/text_secondary"
        android:textSize="17sp" />
    <Space
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartJourney"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Bắt đầu hành trình   ➜"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:backgroundTint="@color/primary_green"
        android:contentDescription="Bắt đầu hành trình AuraPlate"
        android:layout_marginTop="28dp" />
  </LinearLayout>
</ScrollView>
