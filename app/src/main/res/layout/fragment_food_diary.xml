<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_aura_screen">
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fillViewport="true"
      android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp"
        android:paddingBottom="24dp">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="6dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">
            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:text="‹"
                android:textColor="#267D4C"
                android:textSize="30sp"
                android:id="@+id/diaryBack"
                android:gravity="center"
                android:minHeight="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Quay về Trang chủ" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhật ký ăn uống"
                android:textColor="#1F3D2E"
                android:textSize="23sp"
                android:textStyle="bold" />
          </LinearLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Theo dõi bữa ăn hằng ngày để duy trì cân bằng dinh dưỡng"
              android:textColor="@color/text_secondary"
              android:textSize="13sp"
              android:layout_marginTop="6dp"
              android:maxLines="3"
              android:lineSpacingExtra="2dp" />
        </LinearLayout>
        <ImageView
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:src="@drawable/ap_food_bowl"
            android:scaleType="fitCenter"
            android:contentDescription="Minh họa AuraPlate"
            android:layout_marginStart="6dp" />
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="18dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/bg_fgm_card"
          android:padding="8dp">
        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="#267D4C"
            android:textSize="28sp"
            android:id="@+id/diaryPrevDate"
            android:gravity="center"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ngày trước" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Hôm nay"
            android:textColor="#1F3D2E"
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/diaryDateText"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:contentDescription="Chạm để mở lịch chọn ngày và tháng" />
        <TextView
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#267D4C"
            android:textSize="28sp"
            android:id="@+id/diaryNextDate"
            android:gravity="center"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ngày sau" />
      </LinearLayout>
      <com.google.android.material.card.MaterialCardView
          android:id="@+id/diaryCalendarCard"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:layout_marginBottom="8dp"
          android:visibility="gone"
          app:cardBackgroundColor="#FFFFFF"
          app:cardCornerRadius="20dp"
          app:cardElevation="2dp"
          app:strokeColor="#D7E8DC"
          app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:paddingHorizontal="6dp"
              android:paddingTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chọn ngày và tháng"
                android:textColor="#1F3D2E"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/diaryDateToday"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Hôm nay"
                android:textSize="14sp"
                android:textColor="#267D4C"
                android:textStyle="bold" />
          </LinearLayout>
          <CalendarView
              android:id="@+id/diaryCalendar"
              android:layout_width="match_parent"
              android:layout_height="320dp"
              android:showWeekNumber="false" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <Space
          android:layout_width="match_parent"
          android:layout_height="16dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp"
          android:background="@drawable/bg_fgm_card">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tổng năng lượng đã nạp"
            android:textColor="#1F3D2E"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 kcal"
            android:textColor="#267D4C"
            android:textSize="27sp"
            android:textStyle="bold"
            android:id="@+id/diaryTotalKcal" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />
        <ProgressBar
            android:id="@+id/diaryProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:max="2000"
            android:progress="0"
            android:progressTint="#267D4C" />
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="18dp" />
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Các bữa ăn"
          android:textColor="#1F3D2E"
          android:textSize="17sp"
          android:textStyle="bold" />
      <Space
          android:layout_width="match_parent"
          android:layout_height="12dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="14dp"
          android:background="@drawable/bg_fgm_card"
          android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="☀"
            android:textColor="#D89C10"
            android:textSize="25sp"
            android:gravity="center"
            android:background="@drawable/bg_meal_breakfast" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Bữa sáng"
              android:textColor="#1F3D2E"
              android:textSize="15sp"
              android:textStyle="bold" />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Chưa ghi nhận món"
              android:textColor="@color/text_secondary"
              android:textSize="13sp"
              android:id="@+id/diaryBreakfastInfo"
              android:layout_marginTop="4dp"
              android:lineSpacingExtra="2dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/diaryBreakfastAdd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="23sp"
            android:background="@drawable/bg_fgm_button" />
      </LinearLayout>
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="14dp"
          android:background="@drawable/bg_fgm_card"
          android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="🍴"
            android:textColor="#267D4C"
            android:textSize="25sp"
            android:gravity="center"
            android:background="@drawable/bg_meal_lunch" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Bữa trưa"
              android:textColor="#1F3D2E"
              android:textSize="15sp"
              android:textStyle="bold" />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Chưa ghi nhận món"
              android:textColor="@color/text_secondary"
              android:textSize="13sp"
              android:id="@+id/diaryLunchInfo"
              android:layout_marginTop="4dp"
              android:lineSpacingExtra="2dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/diaryLunchAdd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="23sp"
            android:background="@drawable/bg_fgm_button" />
      </LinearLayout>
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="14dp"
          android:background="@drawable/bg_fgm_card"
          android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="☾"
            android:textColor="#8340CF"
            android:textSize="25sp"
            android:gravity="center"
            android:background="@drawable/bg_meal_dinner" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Bữa tối"
              android:textColor="#1F3D2E"
              android:textSize="15sp"
              android:textStyle="bold" />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Chưa ghi nhận món"
              android:textColor="@color/text_secondary"
              android:textSize="13sp"
              android:id="@+id/diaryDinnerInfo"
              android:layout_marginTop="4dp"
              android:lineSpacingExtra="2dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/diaryDinnerAdd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="23sp"
            android:background="@drawable/bg_fgm_button" />
      </LinearLayout>
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="14dp"
          android:background="@drawable/bg_fgm_card"
          android:layout_marginBottom="10dp">
        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="🍎"
            android:textColor="#EE506A"
            android:textSize="25sp"
            android:gravity="center"
            android:background="@drawable/bg_meal_snack" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Bữa phụ"
              android:textColor="#1F3D2E"
              android:textSize="15sp"
              android:textStyle="bold" />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Chưa ghi nhận món"
              android:textColor="@color/text_secondary"
              android:textSize="13sp"
              android:id="@+id/diarySnackInfo"
              android:layout_marginTop="4dp"
              android:lineSpacingExtra="2dp" />
        </LinearLayout>
        <TextView
            android:id="@+id/diarySnackAdd"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="+"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="23sp"
            android:background="@drawable/bg_fgm_button" />
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="12dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:background="@drawable/bg_fgm_soft"
          android:paddingHorizontal="20dp"
          android:paddingVertical="18dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Lời khuyên"
            android:textColor="#267D4C"
            android:textSize="15sp"
            android:textStyle="bold" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="4dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hãy bổ sung rau xanh và uống đủ nước mỗi ngày."
            android:textColor="#5E8068"
            android:textSize="14sp"
            android:id="@+id/diaryTipText"
            android:lineSpacingExtra="3dp" />
      </LinearLayout>
    </LinearLayout>
  </ScrollView>
</LinearLayout>
