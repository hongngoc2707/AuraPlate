<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_aura_rounded"
    android:padding="8dp">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="18dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
      <TextView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:text="Hoạt động khác"
          android:textColor="#1F3D2E"
          android:textSize="19sp"
          android:textStyle="bold"
          android:layout_weight="1" />
      <TextView
          android:layout_width="40dp"
          android:layout_height="wrap_content"
          android:text="×"
          android:textColor="#267D4C"
          android:textSize="26sp"
          android:id="@+id/otherClose"
          android:gravity="center" />
    </LinearLayout>
    <Space
        android:layout_width="match_parent"
        android:layout_height="4dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nhập tên hoạt động bạn muốn ghi lại."
        android:textColor="#7A9081"
        android:textSize="13sp" />
    <Space
        android:layout_width="match_parent"
        android:layout_height="16dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tên hoạt động"
        android:textColor="#1F3D2E"
        android:textSize="14sp"
        android:textStyle="bold" />
    <Space
        android:layout_width="match_parent"
        android:layout_height="6dp" />
    <EditText
        android:id="@+id/otherNameInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:singleLine="true"
        android:textSize="14sp"
        android:hint="VD: Cầu lông, leo núi..."
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_fgm_input"
        android:minHeight="48dp" />
    <Space
        android:layout_width="match_parent"
        android:layout_height="17dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
      <TextView
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:text="Hủy"
          android:textColor="#267D4C"
          android:textSize="14sp"
          android:textStyle="bold"
          android:id="@+id/otherCancel"
          android:layout_weight="1"
          android:gravity="center"
          android:background="@drawable/bg_fgm_card"
          android:layout_marginEnd="6dp" />
      <TextView
          android:layout_width="0dp"
          android:layout_height="48dp"
          android:text="Xác nhận"
          android:textColor="#FFFFFF"
          android:textSize="14sp"
          android:textStyle="bold"
          android:id="@+id/otherConfirm"
          android:layout_weight="1"
          android:gravity="center"
          android:background="@drawable/bg_fgm_button" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
