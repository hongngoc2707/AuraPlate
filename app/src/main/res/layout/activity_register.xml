<?xml version='1.0' encoding='UTF-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aura_screen"
    android:fillViewport="true">
  <androidx.constraintlayout.widget.ConstraintLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:padding="24dp">
    <ImageButton
        android:id="@+id/btnBackRegister"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_circle_button"
        android:backgroundTint="@color/card_bg"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageView
        android:id="@+id/ivRegisterLogo"
        android:layout_width="130dp"
        android:layout_height="124dp"
        android:layout_marginTop="8dp"
        android:contentDescription="Logo AuraPlate"
        android:scaleType="fitCenter"
        android:src="@drawable/ap_app_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnBackRegister" />
    <TextView
        android:id="@+id/tvRegisterTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Tạo tài khoản"
        android:textColor="@color/text_primary"
        android:textSize="23sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/ivRegisterLogo" />
    <TextView
        android:id="@+id/tvRegisterSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="Bắt đầu hành trình sống khỏe cùng AuraPlate"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvRegisterTitle" />
    <!-- 1. Họ và tên -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilFullName"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        app:boxBackgroundColor="@color/white"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="#D8E2DC"
        app:boxStrokeWidth="1dp"
        app:hintEnabled="false"
        app:layout_constraintTop_toBottomOf="@+id/tvRegisterSubtitle"
        app:startIconDrawable="@drawable/ic_person"
        app:startIconTint="#6C7D74">
      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/edtFullName"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:hint="Họ và tên"
          android:inputType="textPersonName"
          android:paddingVertical="14dp"
          android:textColor="@color/text_primary"
          android:textColorHint="@color/text_muted"
          android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>
    <!-- 2. Địa chỉ email -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRegEmail"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@color/white"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="#D8E2DC"
        app:boxStrokeWidth="1dp"
        app:hintEnabled="false"
        app:layout_constraintTop_toBottomOf="@+id/tilFullName"
        app:startIconDrawable="@drawable/ic_mail_outline"
        app:startIconTint="#6C7D74">
      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/edtRegEmail"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:hint="Địa chỉ email"
          android:inputType="textEmailAddress"
          android:paddingVertical="14dp"
          android:textColor="@color/text_primary"
          android:textColorHint="@color/text_muted"
          android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>
    <!-- 3. Mật khẩu (tối thiểu 8 ký tự) -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilRegPass"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@color/white"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="#D8E2DC"
        app:boxStrokeWidth="1dp"
        app:endIconMode="password_toggle"
        app:endIconTint="#6C7D74"
        app:hintEnabled="false"
        app:layout_constraintTop_toBottomOf="@+id/tilRegEmail"
        app:startIconDrawable="@drawable/ic_lock_outline"
        app:startIconTint="#6C7D74">
      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/edtRegPass"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:hint="Mật khẩu (tối thiểu 8 ký tự)"
          android:inputType="textPassword"
          android:paddingVertical="14dp"
          android:textColor="@color/text_primary"
          android:textColorHint="@color/text_muted"
          android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>
    <!-- 4. Xác nhận mật khẩu -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilConfirmPass"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:boxBackgroundColor="@color/white"
        app:boxCornerRadiusBottomEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusTopStart="16dp"
        app:boxStrokeColor="#D8E2DC"
        app:boxStrokeWidth="1dp"
        app:endIconMode="password_toggle"
        app:endIconTint="#6C7D74"
        app:hintEnabled="false"
        app:layout_constraintTop_toBottomOf="@+id/tilRegPass"
        app:startIconDrawable="@drawable/ic_lock_outline"
        app:startIconTint="#6C7D74">
      <com.google.android.material.textfield.TextInputEditText
          android:id="@+id/edtConfirmPass"
          android:layout_width="match_parent"
          android:layout_height="56dp"
          android:hint="Xác nhận mật khẩu"
          android:inputType="textPassword"
          android:paddingVertical="14dp"
          android:textColor="@color/text_primary"
          android:textColorHint="@color/text_muted"
          android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>
    <!-- Checkbox Điều khoản -->
    <CheckBox
        android:id="@+id/cbAgreeTerms"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:checked="true"
        android:text="Tôi đồng ý với Điều khoản sử dụng &amp; Chính sách bảo mật của AuraPlate"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tilConfirmPass" />
    <!-- Nút Đăng ký -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSubmitRegister"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="24dp"
        android:text="Tiếp tục (Thiết lập hồ sơ)"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_green"
        app:cornerRadius="14dp"
        app:layout_constraintTop_toBottomOf="@+id/cbAgreeTerms" />
    <!-- Link về Đăng nhập -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSubmitRegister">
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Đã có tài khoản? "
          android:textColor="@color/text_secondary"
          android:textSize="14sp" />
      <TextView
          android:id="@+id/tvGoToLogin"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Đăng nhập"
          android:textColor="@color/primary_green"
          android:textSize="14sp"
          android:textStyle="bold" />
    </LinearLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
