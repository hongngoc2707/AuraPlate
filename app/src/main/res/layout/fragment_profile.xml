<?xml version='1.0' encoding='UTF-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_aura_screen"
    android:fillViewport="true">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="20dp"
      android:paddingBottom="24dp">
    <!-- Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cá nhân"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />
    <!-- User Info Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/card_bg"
        app:cardCornerRadius="20dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/border_light"
        app:strokeWidth="1dp">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:gravity="center"
          android:orientation="vertical"
          android:padding="20dp">
        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@null"
            android:src="@drawable/ap_avatar"
            android:scaleType="fitCenter"
            android:contentDescription="Minh họa AuraPlate" />
        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Nguyễn Văn An"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="an.nguyen@auraplate.vn"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_badge"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">
          <TextView
              android:id="@+id/tvProfileHeight"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:gravity="center"
              android:text="📏 172 cm"
              android:textColor="@color/primary_green_dark"
              android:textSize="13sp"
              android:textStyle="bold" />
          <View
              android:layout_width="1dp"
              android:layout_height="16dp"
              android:background="@color/divider" />
          <TextView
              android:id="@+id/tvProfileWeight"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:gravity="center"
              android:text="⚖️ 57.4 kg"
              android:textColor="@color/primary_green_dark"
              android:textSize="13sp"
              android:textStyle="bold" />
          <View
              android:layout_width="1dp"
              android:layout_height="16dp"
              android:background="@color/divider" />
          <TextView
              android:id="@+id/tvProfileBmi"
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:gravity="center"
              android:text="🎯 BMI 22.8"
              android:textColor="@color/primary_green_dark"
              android:textSize="13sp"
              android:textStyle="bold" />
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <!-- Menu Settings Options -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Cài đặt &amp; Quản lý"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_rounded_card"
        android:orientation="vertical">
      <!-- 1. Edit Profile -->
      <LinearLayout
          android:id="@+id/btnMenuEditProfile"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingHorizontal="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤"
            android:textSize="18sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Chỉnh sửa thông tin cá nhân"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/text_muted"
            android:textSize="20sp" />
      </LinearLayout>
      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginHorizontal="16dp"
          android:background="@color/divider" />
      <!-- 2. Goal Settings -->
      <LinearLayout
          android:id="@+id/btnMenuGoalSetting"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingHorizontal="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯"
            android:textSize="18sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Kế hoạch mục tiêu cân nặng"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/text_muted"
            android:textSize="20sp" />
      </LinearLayout>
      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginHorizontal="16dp"
          android:background="@color/divider" />
      <!-- 3. Weight Progress -->
      <LinearLayout
          android:id="@+id/btnMenuWeightProgress"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingHorizontal="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📈"
            android:textSize="18sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Biểu đồ tiến độ cân nặng"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/text_muted"
            android:textSize="20sp" />
      </LinearLayout>
      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:layout_marginHorizontal="16dp"
          android:background="@color/divider" />
      <!-- 4. Goal Evaluation Report -->
      <LinearLayout
          android:id="@+id/btnMenuGoalEvaluation"
          android:layout_width="match_parent"
          android:layout_height="54dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingHorizontal="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆"
            android:textSize="18sp" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:text="Báo cáo đánh giá tiến độ (Báo cáo 3)"
            android:textColor="@color/primary_green"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="@color/primary_green"
            android:textSize="20sp" />
      </LinearLayout>
    </LinearLayout>
    <!-- Button Logout -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:text="Đăng xuất"
        android:textColor="@color/accent_red"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/accent_red_light"
        app:cornerRadius="14dp" />
  </LinearLayout>
</ScrollView>
