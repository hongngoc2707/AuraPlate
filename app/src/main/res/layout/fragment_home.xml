<?xml version='1.0' encoding='UTF-8'?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_aura_screen">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="20dp"
      android:paddingEnd="20dp"
      android:paddingTop="24dp"
      android:paddingBottom="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHÀO MỪNG BẠN ĐẾN VỚI AURAPLATE"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvHomeGreeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Xin chào, bạn!"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="24sp" />
        <TextView
            android:id="@+id/tvHomeDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hãy xây dựng hành trình sống khỏe"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
      </LinearLayout>
      <ImageView
          android:id="@+id/ivHomeAvatar"
          android:layout_width="56dp"
          android:layout_height="56dp"
          android:src="@drawable/ap_profile_icon"
          android:background="@drawable/bg_fgm_soft"
          android:padding="7dp"
          android:contentDescription="Xem hồ sơ cá nhân" />
    </LinearLayout>
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="204dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/white"
        app:strokeColor="@color/border_light"
        app:strokeWidth="1dp">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:orientation="vertical"
          android:padding="18dp"
          android:paddingBottom="24dp">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Tổng hợp năng lượng hôm nay"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
          <FrameLayout
              android:layout_width="0dp"
              android:layout_height="136dp"
              android:layout_weight="1">
            <ProgressBar
                android:id="@+id/progressCalorieCircle"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                android:max="100"
                android:progress="45"
                android:progressDrawable="@drawable/bg_circular_progress" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">
              <TextView
                  android:id="@+id/tvCaloriesConsumed"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="----"
                  android:textSize="22sp"
                  android:textStyle="bold"
                  android:textColor="@color/primary_green" />
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="kcal đã nạp"
                  android:textSize="12sp"
                  android:textColor="@color/text_secondary" />
            </LinearLayout>
          </FrameLayout>
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="match_parent"
              android:layout_weight="1"
              android:orientation="vertical"
              android:gravity="center_vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:background="@drawable/bg_fgm_soft"
                android:padding="12dp"
                android:orientation="vertical"
                android:gravity="center_vertical">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Vận động"
                  android:textColor="@color/text_secondary"
                  android:textSize="12sp"
                  android:singleLine="true" />
              <TextView
                  android:id="@+id/tvCaloriesBurned"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="--- kcal"
                  android:textSize="17sp"
                  android:textStyle="bold"
                  android:textColor="@color/primary_green" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_fgm_cream"
                android:padding="12dp"
                android:orientation="vertical"
                android:gravity="center_vertical">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Cân nặng gần nhất"
                  android:textColor="@color/text_secondary"
                  android:textSize="12sp" />
              <TextView
                  android:id="@+id/tvLatestWeight"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="--- kg"
                  android:textSize="17sp"
                  android:textStyle="bold"
                  android:textColor="@color/primary_green" />
            </LinearLayout>
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="Truy cập nhanh"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="98dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
      <LinearLayout
          android:id="@+id/quickDiet"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center"
          android:background="@drawable/bg_fgm_card"
          android:layout_marginEnd="4dp"
          android:clickable="true"
          android:focusable="true">
        <ImageView
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:src="@drawable/ap_fork_green"
            android:background="@drawable/bg_fgm_soft"
            android:padding="8dp"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Ăn uống"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:singleLine="true" />
      </LinearLayout>
      <LinearLayout
          android:id="@+id/quickExercise"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center"
          android:background="@drawable/bg_fgm_card"
          android:layout_marginEnd="4dp"
          android:clickable="true"
          android:focusable="true">
        <ImageView
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:src="@drawable/ap_fitness_icon"
            android:background="@drawable/bg_fgm_soft"
            android:padding="9dp"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Vận động"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:singleLine="true" />
      </LinearLayout>
      <LinearLayout
          android:id="@+id/quickGoal"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center"
          android:background="@drawable/bg_fgm_card"
          android:layout_marginEnd="4dp"
          android:clickable="true"
          android:focusable="true">
        <ImageView
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:src="@drawable/ap_target_icon"
            android:background="@drawable/bg_fgm_soft"
            android:padding="8dp"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Mục tiêu"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:singleLine="true" />
      </LinearLayout>
      <LinearLayout
          android:id="@+id/quickProgress"
          android:layout_width="0dp"
          android:layout_height="match_parent"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center"
          android:background="@drawable/bg_fgm_card"
          android:clickable="true"
          android:focusable="true">
        <ImageView
            android:layout_width="47dp"
            android:layout_height="47dp"
            android:src="@drawable/ic_analytics"
            android:background="@drawable/bg_fgm_soft"
            android:padding="9dp"
            app:tint="@color/primary_green"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Tiến độ"
            android:gravity="center"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:singleLine="true" />
      </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_fgm_cream"
        android:clipChildren="false">
      <ImageView
          android:layout_width="136dp"
          android:layout_height="134dp"
          android:layout_gravity="end|center_vertical"
          android:src="@drawable/ap_salad"
          android:scaleType="fitCenter"
          android:contentDescription="Bữa ăn lành mạnh" />
      <LinearLayout
          android:layout_width="225dp"
          android:layout_height="match_parent"
          android:orientation="vertical"
          android:padding="12dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ăn uống lành mạnh"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:textSize="16sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="bắt đầu từ hôm nay"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHomeAddFood"
            android:layout_width="142dp"
            android:layout_height="42dp"
            android:layout_marginTop="2dp"
            android:text="Thêm món ăn   ➜"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/white"
            android:backgroundTint="@color/primary_green"
            app:cornerRadius="20dp" />
      </LinearLayout>
    </FrameLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Nhật ký hôm nay"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_fgm_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">
      <ImageView
          android:layout_width="58dp"
          android:layout_height="58dp"
          android:src="@drawable/ap_meal_recent"
          android:scaleType="fitCenter"
          android:importantForAccessibility="no" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="12dp"
          android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bữa ăn gần nhất"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <TextView
            android:id="@+id/tvLatestFood"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa ghi nhận món ăn"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
        <TextView
            android:id="@+id/tvLatestFoodKcal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-- kcal"
            android:textSize="13sp"
            android:textColor="@color/primary_green" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="86dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_fgm_card"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="10dp">
      <ImageView
          android:layout_width="58dp"
          android:layout_height="58dp"
          android:src="@drawable/ap_fitness_icon"
          android:padding="8dp"
          android:background="@drawable/bg_fgm_soft"
          android:importantForAccessibility="no" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginStart="12dp"
          android:orientation="vertical">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hoạt động gần đây"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />
        <TextView
            android:id="@+id/tvLatestExercise"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa có hoạt động"
            android:maxLines="1"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="@color/text_secondary" />
        <TextView
            android:id="@+id/tvLatestExerciseKcal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="-- kcal"
            android:textSize="13sp"
            android:textColor="@color/primary_green" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</ScrollView>
