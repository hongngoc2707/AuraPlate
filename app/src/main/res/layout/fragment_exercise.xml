<?xml version='1.0' encoding='UTF-8'?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_aura_screen">
  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="22dp"
        android:paddingBottom="36dp">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:layout_marginBottom="6dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">
            <TextView
                android:layout_width="42dp"
                android:layout_height="wrap_content"
                android:text="‹"
                android:textColor="#267D4C"
                android:textSize="30sp"
                android:id="@+id/exerciseBack"
                android:gravity="center"
                android:minHeight="48dp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Quay về Trang chủ" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vận động"
                android:textColor="#1F3D2E"
                android:textSize="23sp"
                android:textStyle="bold" />
          </LinearLayout>
          <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Ghi nhận hoạt động mỗi ngày để duy trì lối sống khỏe mạnh."
              android:textColor="#708978"
              android:textSize="13sp"
              android:layout_marginTop="6dp"
              android:maxLines="3"
              android:lineSpacingExtra="2dp" />
        </LinearLayout>
        <ImageView
            android:layout_width="108dp"
            android:layout_height="108dp"
            android:src="@drawable/ap_water_bottle"
            android:scaleType="fitCenter"
            android:contentDescription="Minh họa AuraPlate"
            android:layout_marginStart="6dp" />
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="16dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/bg_fgm_card"
          android:padding="8dp">
        <TextView
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:text="‹"
            android:textColor="#267D4C"
            android:textSize="28sp"
            android:id="@+id/exercisePrevDate"
            android:gravity="center"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ngày trước" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Hôm nay"
            android:textColor="#1F3D2E"
            android:textSize="15sp"
            android:textStyle="bold"
            android:id="@+id/exerciseDateText"
            android:layout_weight="1"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:contentDescription="Chạm để mở lịch chọn ngày và tháng" />
        <TextView
            android:layout_width="38dp"
            android:layout_height="wrap_content"
            android:text="›"
            android:textColor="#267D4C"
            android:textSize="28sp"
            android:id="@+id/exerciseNextDate"
            android:gravity="center"
            android:minHeight="48dp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Ngày sau" />
      </LinearLayout>
      <com.google.android.material.card.MaterialCardView
          android:id="@+id/exerciseCalendarCard"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="10dp"
          android:layout_marginBottom="8dp"
          android:visibility="gone"
          app:cardBackgroundColor="#FFFFFF"
          app:cardCornerRadius="20dp"
          app:cardElevation="2dp"
          app:strokeColor="#D7E8DC"
          app:strokeWidth="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:paddingHorizontal="6dp"
              android:paddingTop="4dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chọn ngày và tháng"
                android:textColor="#1F3D2E"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/exerciseDateToday"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:clickable="true"
                android:focusable="true"
                android:text="Hôm nay"
                android:textSize="14sp"
                android:textColor="#267D4C"
                android:textStyle="bold" />
          </LinearLayout>
          <CalendarView
              android:id="@+id/exerciseCalendar"
              android:layout_width="match_parent"
              android:layout_height="320dp"
              android:showWeekNumber="false" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>
      <Space
          android:layout_width="match_parent"
          android:layout_height="18dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="17dp"
          android:background="@drawable/bg_fgm_card">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tổng thời gian vận động"
            android:textColor="#1F3D2E"
            android:textSize="16sp"
            android:textStyle="bold" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 phút"
            android:textColor="#267D4C"
            android:textSize="25sp"
            android:textStyle="bold"
            android:id="@+id/exerciseTotalMinutes" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp" />
        <ProgressBar
            android:id="@+id/exerciseProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="9dp"
            android:max="30"
            android:progress="0"
            android:progressTint="#267D4C" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥  0 kcal tiêu hao"
            android:textColor="#267D4C"
            android:textSize="16sp"
            android:textStyle="bold"
            android:id="@+id/exerciseTotalKcal" />
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="18dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Danh sách hoạt động"
            android:textColor="#1F3D2E"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Thêm hoạt động"
            android:textColor="#267D4C"
            android:textSize="13sp"
            android:textStyle="bold"
            android:id="@+id/exerciseAdd" />
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="10dp" />
      <LinearLayout
          android:id="@+id/exerciseListContainer"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical" />
      <Space
          android:layout_width="match_parent"
          android:layout_height="24dp" />
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="20dp"
          android:paddingVertical="18dp"
          android:background="@drawable/bg_fgm_soft">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💡 Lời khuyên"
            android:textColor="#267D4C"
            android:textSize="15sp"
            android:textStyle="bold" />
        <Space
            android:layout_width="match_parent"
            android:layout_height="9dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Duy trì vận động đều đặn và chọn mức tập phù hợp với thể trạng của bạn."
            android:textColor="#5F806A"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:id="@+id/exerciseTipText" />
      </LinearLayout>
      <Space
          android:layout_width="match_parent"
          android:layout_height="18dp" />
    </LinearLayout>
  </ScrollView>
</LinearLayout>
