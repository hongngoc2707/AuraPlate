<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AuraPlate" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/primary_green_light</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <item name="android:statusBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.AuraPlate" parent="Base.Theme.AuraPlate" />

    <!-- Custom View Styles -->
    <style name="Widget.AuraPlate.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="Widget.AuraPlate.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.AuraPlate.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="strokeColor">@color/primary_green</item>
        <item name="android:textColor">@color/primary_green</item>
        <item name="cornerRadius">@dimen/radius_button</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
